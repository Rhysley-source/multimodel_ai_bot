# JWT Settings — generate with: openssl rand -hex 32
SECRET_KEY=your-strong-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=200
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/multimodel_bot

# LLM API Keys — add only the providers you use
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROK_API_KEY=xai-...
# DEEPSEEK_API_KEY=sk-...

# Default model: gpt-mini | gpt | claude | claude-opus | grok | grok-mini | deepseek | deepseek-r1
DEFAULT_MODEL=gpt-mini

# System prompt
SYSTEM_PROMPT=You are a helpful, friendly AI assistant. Answer clearly and concisely.

# CORS — use * for dev, specific origins for production
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
